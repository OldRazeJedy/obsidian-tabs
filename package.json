{
  "name": "obsidian-tabs",
  "version": "1.2.2",
  "description": "Create tabs in your notes.",
  "author": "OldRazeJedy",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "npx -y -p obsidian-plugin-cli@0.8.3 obsidian-plugin build --with-stylesheet src/styles.css src/main.ts",
    "postbuild": "node -e \"const fs=require('fs'),path=require('path');for(const f of ['main.js','styles.css','manifest.json']){fs.copyFileSync(path.join('dist',f),f);}const vaultPluginDir='F:/MyGame/Personal/.obsidian/plugins/tabs';if(fs.existsSync('F:/MyGame/Personal/.obsidian/plugins')){fs.mkdirSync(vaultPluginDir,{recursive:true});for(const f of ['main.js','styles.css','manifest.json']){fs.copyFileSync(path.join('dist',f),path.join(vaultPluginDir,f));}}\"",
    "dev": "npx -y -p obsidian-plugin-cli@0.8.3 obsidian-plugin dev --vault-path F:/MyGame/Personal --with-stylesheet src/styles.css src/main.ts"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.2.4",
    "codemirror": "^6.0.1",
    "obsidian": "1.8.7",
    "typescript": "5.9"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.3"
  }
}
